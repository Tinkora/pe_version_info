#include <windows.h>

1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 5,6,7,8
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Tinkora"
      VALUE "FileDescription", "PE Version Info fixture"
      VALUE "FileVersion", "1.2.3.4"
      VALUE "OriginalFilename", "fixture.exe"
      VALUE "ProductName", "PE Version Info"
      VALUE "ProductVersion", "5.6.7.8"
      VALUE "UnknownFixtureField", "preserve-me"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

101 RCDATA
BEGIN
  "PEVI_UNRELATED_RESOURCE"
END
